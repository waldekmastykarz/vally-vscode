{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug VS Code executor (active profile)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/debug/run.ts",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "killBehavior": "polite",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
